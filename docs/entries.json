  },
  {
    "guid": "https://www.thefarside.com/2026/11/19/1",
    "image": "https://featureassets.amuniversal.com/assets/71fe3b90cdd20137c56b005056a9545d",
    "link": "https://www.thefarside.com/2026/11/19/1",
