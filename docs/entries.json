  },
  {
    "guid": "https://www.thefarside.com/2026/10/16/2",
    "image": "https://featureassets.amuniversal.com/assets/8eb97370c1520137c0b4005056a9545d",
    "link": "https://www.thefarside.com/2026/10/16/2",
