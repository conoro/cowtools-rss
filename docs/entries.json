  },
  {
    "guid": "https://www.thefarside.com/2026/10/08/2",
    "image": "https://featureassets.amuniversal.com/assets/255ea800cdd30137c56b005056a9545d",
    "link": "https://www.thefarside.com/2026/10/08/2",
    "published": "2026-10-08T12:02:00.000Z",
    "title": "\"And that goes for Lancelot, Galahad, and the rest of you guys no more stickin' your gum under the table.\""
  },
  {
    "guid": "https://www.thefarside.com/2026/10/08/1",
    "image": "https://featureassets.amuniversal.com/assets/1f2443d0df120137cbaf005056a9545d",
    "link": "https://www.thefarside.com/2026/10/08/1",
    "published": "2026-10-08T12:01:00.000Z",
    "title": "\"And here we are last summer going south. Wait a minute, Irene! We went north last summer! The stupid slide's in backwards!\""
  },
  {
    "guid": "https://www.thefarside.com/2026/10/08/0",
    "image": "https://featureassets.amuniversal.com/assets/13150aa0cdd50137c56b005056a9545d",
    "link": "https://www.thefarside.com/2026/10/08/0",
    "published": "2026-10-08T12:00:00.000Z",
    "title": "\"Okay, Pete! Start the pressure nice and easy.\""
  },
  {
    "guid": "https://www.thefarside.com/2026/10/07/4",
    "image": "https://featureassets.amuniversal.com/assets/4b49edd0e92e0137cf47005056a9545d",
    "link": "https://www.thefarside.com/2026/10/07/4",
    "published": "2026-10-07T12:04:00.000Z",
