  },
  {
    "guid": "https://www.thefarside.com/2026/11/12/0",
    "image": "https://featureassets.amuniversal.com/assets/ba56af70cdd20137c56b005056a9545d",
    "link": "https://www.thefarside.com/2026/11/12/0",
