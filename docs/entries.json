  {
    "guid": "https://www.thefarside.com/2026/10/16/1",
    "image": "https://featureassets.amuniversal.com/assets/26f7d240fa840137d52f005056a9545d",
    "link": "https://www.thefarside.com/2026/10/16/1",
    "published": "2026-10-16T12:01:00.000Z",
    "title": "\"Hey! C'mon! Hold it! Hold it! ... Or someone's gonna get hurt!\""
  },
  {
    "guid": "https://www.thefarside.com/2026/10/16/0",
    "image": "https://featureassets.amuniversal.com/assets/ce03fb80df100137cbaf005056a9545d",
    "link": "https://www.thefarside.com/2026/10/16/0",
    "published": "2026-10-16T12:00:00.000Z",
    "title": "\"Egad! Willard's home early! Don't move his vision's not very good, but his sense of smell and hearing are quite acute.\""
  },
  {
    "guid": "https://www.thefarside.com/2026/10/08/4",
    "image": "https://featureassets.amuniversal.com/assets/8653be60cdd20137c56b005056a9545d",
    "link": "https://www.thefarside.com/2026/10/08/4",
    "published": "2026-10-08T12:04:00.000Z",
    "title": "\"That does it! I'm going to go up there and give those people hell!\""
  },
  {
    "guid": "https://www.thefarside.com/2026/10/08/3",
    "image": "https://featureassets.amuniversal.com/assets/9c2feb30d8b90137c959005056a9545d",
    "link": "https://www.thefarside.com/2026/10/08/3",
    "published": "2026-10-08T12:03:00.000Z",
